# Server-only Cloudflare Workers AI credentials. Never add these to browser JS or GitHub.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-private-workers-ai-token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Supabase project values used by the server to validate sessions and enforce the daily AI cap.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-publishable-or-anon-key

